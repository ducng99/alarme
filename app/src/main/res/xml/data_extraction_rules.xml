<?xml version="1.0" encoding="utf-8"?>
<!-- Alarme never hands its data to the platform backup: exports are explicit, user-driven files. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
