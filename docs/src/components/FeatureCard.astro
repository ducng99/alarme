---
import { Icon } from 'astro-icon/components';
import type { Item } from '../data/content';

interface Props {
  item: Item;
  tone?: 'primary' | 'tertiary';
}

const { item, tone = 'primary' } = Astro.props;
const iconClass = tone === 'primary' ? 'bg-primary-container text-on-primary-container' : 'bg-tertiary-container text-on-tertiary-container';
---

<article class="group rounded-3xl bg-surface-container-low p-6 transition duration-300 hover:-translate-y-1 hover:bg-surface-container">
  <div class:list={['mb-4 flex size-12 items-center justify-center rounded-2xl transition-[border-radius] duration-300 group-hover:rounded-[1.5rem]', iconClass]}>
    <Icon name={item.icon} class="size-6" />
  </div>
  <h3 class="font-display text-lg font-semibold">{item.title}</h3>
  <p class="mt-1 text-sm leading-relaxed text-on-surface-variant">{item.body}</p>
</article>
