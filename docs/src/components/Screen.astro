---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import PhoneFrame from './PhoneFrame.astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  class?: string;
  eager?: boolean;
}

const { src, alt, class: className, eager = false } = Astro.props;
---

<PhoneFrame class={className}>
  <Image src={src} alt={alt} widths={[360, 720]} sizes="(min-width: 1024px) 320px, 70vw" loading={eager ? 'eager' : 'lazy'} />
</PhoneFrame>
